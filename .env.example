# Admin API (catalogue, texts, contacts and leads). Optional — defaults shown.
# API_URL=https://api.expertmachinery.kz

# Request form → e-mail fallback when the admin API is unreachable
# (src/app/api/request/route.ts).
# Gmail: SMTP_USER is the mailbox, SMTP_PASS is a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Set these in Vercel → Project → Settings → Environment Variables.
SMTP_USER=expertmachinerykz@gmail.com
SMTP_PASS=
# Optional — defaults shown.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# REQUEST_TO=expertmachinerykz@gmail.com

# SEO. Canonical domain (default shown) and the "HTML tag" verification codes
# from Google Search Console and Yandex Webmaster (only the content="…" value).
# NEXT_PUBLIC_SITE_URL=https://www.expertmachinery.kz
GOOGLE_SITE_VERIFICATION=
YANDEX_VERIFICATION=
